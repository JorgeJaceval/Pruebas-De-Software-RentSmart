# Copiar únicamente en el VPS: <DEPLOY_ROOT>/shared/.env (permisos 600).
# Generar valores independientes con: openssl rand -hex 32
POSTGRES_USER=rentsmart
POSTGRES_PASSWORD=
POSTGRES_DB=rentsmart
AUTH_SECRET_KEY=
AUTH_TOKEN_MINUTES=30
# Dominio sin esquema ni ruta; DNS apuntando al VPS, puertos TCP 80/443 libres.
SITE_ADDRESS=rentsmart.example.org
# No configurar RELEASE_SHA aquí: el despliegue lo toma del commit aprobado.
