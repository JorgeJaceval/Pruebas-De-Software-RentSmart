coverage/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Datos locales, volcados y registros
*.db
*.sqlite
*.sqlite3
*.dump
*.log
postgres-data/
pgdata/

# Sistema operativo y editores
.DS_Store
Thumbs.db
Desktop.ini
.idea/
