# Variables de entorno y secretos; conservar ejemplos sin credenciales
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Node / React / Vite
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / FastAPI / Pytest
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
build/

